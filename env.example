# Copy to .env and fill in real values. NEVER commit .env (gitignored).
# NOTE: the Supabase service-role key lives ONLY in Supabase edge function
# secrets, never in this repo and never in any VITE_-prefixed variable —
# VITE_ vars are baked into the public client bundle at build time.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_AZURE_SPEECH_KEY=your_azure_speech_key
VITE_AZURE_SPEECH_REGION=your_azure_region
